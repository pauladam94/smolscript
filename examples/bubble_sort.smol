fn bubble_sort(l : [u64]) -> [u64] {
	let i = 0;
	let cpt = 0;
	while (cpt != l.len()) {
		if l[i] <= l[i + 1] {
			cpt += 1;
		} else {
			let tmp = l[i + 1];
			l[i + 1] := l[i]; 
			l[i] := tmp;
		}
		i := i + 1;
		if i == l.len() {
			i := 0;
		}
	}
	l
}

let l = [];
l.push(12);
l.push(2);
l.push(42);
l.push(13);
l.push(0);

// l is copied here by the function call
bubble_sort(l)
// l is not modified after the call to `bubble_sort`




