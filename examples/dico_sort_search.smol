fn _search(t : [u8], x : u8, start : u8, end : u8) {
    if (start == end) {
        false
    } else {
        let mid = (start + end) / 2;
        if (t[mid] == x) {
            true
        } else if (t[mid] < x) {
            _search(t, x, mid + 1, end)
        } else {
            _search(t, x, start, mid)
		}
	}
};

// Does a dichotomic search on a sorted array of integers.
fn search(dico: [u8], word: u8) -> [u8] {
	_search(dico, word, 0, dico.len())
};


